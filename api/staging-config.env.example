# Copy this file to api/staging-config.env, then fill only the namespace id.
# The values below identify the authorized Barrio 24 staging resources. They are
# not secrets; Access credentials/JWTs remain outside this file and outside Git.

BARRIO24_STAGING_ACCOUNT_ID=9d3274c57217e9cf44020bec6d754fb7
BARRIO24_STAGING_WORKER_NAME=barrio24-reports-api-staging
BARRIO24_STAGING_D1_DATABASE_NAME=barrio24-reports-staging
BARRIO24_STAGING_D1_DATABASE_ID=eca7ac80-6859-40d5-89db-ba1bb6c61173
BARRIO24_STAGING_PAGES_ORIGIN=https://feature-02-rapid-report.barrio24-staging.pages.dev
BARRIO24_STAGING_CRON="0 5 * * *"

# Obtain this value from the existing staging Worker/Cloudflare account.
# It must be a positive integer string unique to the intended rate-limit state.
# Do not invent it and do not reuse the namespace of an unrelated Worker.
BARRIO24_STAGING_RATE_LIMIT_NAMESPACE_ID=
