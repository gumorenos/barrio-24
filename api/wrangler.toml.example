name = "barrio24-reports-api-staging"
main = "src/index.ts"
compatibility_date = "2026-08-13"

[vars]
ALLOWED_ORIGIN = "https://REPLACE-WITH-PAGES-PREVIEW.example"

# Configure these values out of band in the Worker environment; do not commit real values:
# ACCESS_TEAM_DOMAIN = "https://REPLACE-WITH-TEAM.cloudflareaccess.com"
# ACCESS_AUDIENCE = "REPLACE-WITH-ACCESS-AUD"
# ACCESS_OPERATOR_EMAILS = "operator@example.com"

[[d1_databases]]
binding = "DB"
database_name = "barrio24-reports-staging"
database_id = "REPLACE_WITH_STAGING_DATABASE_ID"

[[ratelimits]]
name = "REPORTS_RATE_LIMITER"
namespace_id = "REPLACE_WITH_UNIQUE_RATE_LIMIT_NAMESPACE_ID"

  [ratelimits.simple]
  limit = 10
  period = 60

[triggers]
crons = ["0 5 * * *"]
