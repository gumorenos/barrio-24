{
  "name": "barrio-24",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "tsc -p api/tsconfig.json --pretty false",
