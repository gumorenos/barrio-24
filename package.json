{
  "name": "barrio-24",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --pretty false",
    "typecheck": "tsc -b --pretty false",
    "typecheck:api": "tsc -p api/tsconfig.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck:api && npm run test && npm run test:staging-tools && npm run test:product-tools && npm run build",
    "test:staging-config": "node --test api/scripts/render-staging-wrangler-config.test.mjs",
    "test:staging-tools": "node --test api/scripts/*.test.mjs",
    "staging:config": "node api/scripts/render-staging-wrangler-config.mjs",
    "staging:dry-run": "npm run staging:config && npx --yes --package=wrangler@4.125.0 wrangler deploy --dry-run --config api/wrangler.toml",
    "staging:startup-check": "npm run staging:config && npx --yes --package=wrangler@4.125.0 wrangler check startup api/src/index.ts --config api/wrangler.toml",
    "staging:public-smoke": "node api/scripts/staging-public-smoke.mjs",
    "staging:public-abuse": "node api/scripts/staging-public-abuse-probe.mjs",
    "staging:controlled-load": "node api/scripts/staging-controlled-load.mjs",
    "staging:d1-schema-check": "node api/scripts/staging-d1-schema-check.mjs",
    "staging:readiness-readonly": "node api/scripts/staging-readonly-readiness.mjs",
    "staging:evidence-summary": "node api/scripts/staging-evidence-summary.mjs",
    "test:product-tools": "node --test tools/ruta-alta/*.test.mjs",
    "ruta-alta:source-manifest": "node tools/ruta-alta/source-manifest.mjs",
    "ruta-alta:source-catalog": "node tools/ruta-alta/source-catalog.mjs",
    "ruta-alta:source-fetch": "node tools/ruta-alta/source-fetch.mjs",
    "ruta-alta:source-audit": "node tools/ruta-alta/source-audit.mjs",
    "ruta-alta:zip-inspect": "node tools/ruta-alta/zip-inspect.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "jose": "^6.2.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
