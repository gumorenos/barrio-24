    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck:api && npm run test && npm run build"
  },
  "dependencies": {
    "dexie": "^4.4.4",
    "jose": "^6.2.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
